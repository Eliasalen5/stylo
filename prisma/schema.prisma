// Stylo — Esquema de datos (multi-tenant)
// Convenciones:
//  - Todos los montos se almacenan en pesos enteros (price). Ej: 3000 = $3.000.
//  - Todas las fechas se guardan como UTC (DateTime). La zona horaria del negocio
//    se usa solo para presentación y cálculo de disponibilidad.
//  - Toda entidad de negocio se relaciona con Business (businessId). El tenant
//    siempre se determina en el servidor desde el usuario autenticado.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  PROFESSIONAL
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReminderStatus {
  PENDING
  // Reclamo atómico previo al envío: evita que dos corridas del cron envíen el
  // mismo recordatorio. Si una ejecución muere en PROCESSING, la siguiente
  // corrida lo recupera reenviándolo (al menos una vez).
  PROCESSING
  SENT
  FAILED
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// Frecuencia de cobro del plan (se traduce al plan de recurrencia de
// Mercado Pago cuando el plan se publica).
enum SubscriptionInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

// Tipo de descuento de una promoción:
//  - PERCENTAGE: discountValue es un porcentaje (ej: 10 = 10% de descuento).
//  - FIXED_AMOUNT: discountValue es un monto en pesos (ej: 1500 = $1.500).
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  // Acceso al panel de plataforma (admin global). Se deriva de la lista
  // PLATFORM_ADMIN_EMAILS en el entorno; nunca de datos del cliente.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships          BusinessMember[]
  customerProfiles     Customer[]
  professionalProfiles Professional[]
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  address     String?
  phone       String?
  email       String?
  // Zona horaria del negocio (IANA, ej: "America/Argentina/Buenos_Aires")
  timezone    String   @default("UTC")
  logoUrl     String?
  // Coordenadas geográficas (lat/lng). Se completan geocodificando la
  // dirección (Google Maps Geocoding) o de forma manual. NULL = sin ubicación.
  latitude    Float?
  longitude   Float?
  // Destaque en el directorio público (controlado por la plataforma)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       BusinessMember[]
  professionals Professional[]
  customers     Customer[]
  services      Service[]
  promotions    Promotion[]
  businessHours BusinessHours[]
  appointments  Appointment[]
  subscriptions Subscription[]
  reminders     Reminder[]
}

// Acceso al dashboard de un negocio (tenant). Un usuario puede pertenecer
// a varios negocios con distintos roles.
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(OWNER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

// Prestador de servicios dentro de un negocio. Puede estar asociado a un
// User (si tiene cuenta) o ser gestionado íntegramente por el OWNER.
model Professional {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  email      String?
  phone      String?
  bio        String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  services      Service[]      @relation("ProfessionalServices")
  businessHours BusinessHours[]
  appointments  Appointment[]

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  price           Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals Professional[] @relation("ProfessionalServices")
  appointments  Appointment[]

  @@index([businessId])
}

// Promoción informativa del negocio (M3 — sin descuento aplicado aún en la
// reserva). startsAt/endsAt definen la ventana de validez (fechas en la zona
// horaria del negocio, guardadas como UTC); NULL = sin límite.
model Promotion {
  id            String       @id @default(cuid())
  businessId    String
  name          String
  description   String?
  discountType  DiscountType
  discountValue Int
  // Ventana de validez (opcional). Fuera de este rango la promoción no se muestra.
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Horarios laborales. professionalId NULL = rige para todo el negocio.
// startTime/endTime en formato "HH:MM" (24h) en la zona horaria del negocio.
model BusinessHours {
  id             String   @id @default(cuid())
  businessId     String
  professionalId String?
  dayOfWeek      WeekDay
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
  @@index([professionalId, dayOfWeek])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  reminders    Reminder[]

  @@unique([businessId, userId])
  // Un email no puede repetirse como cliente dentro del mismo negocio.
  // Los NULLs (clientes sin email) no colisionan en PostgreSQL.
  @@unique([businessId, email])
  @@index([businessId])
  @@index([userId])
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  professionalId String
  serviceId      String
  customerId     String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING)
  // Precio del servicio al momento de la reserva (snapshot, en pesos)
  price           Int
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reminders    Reminder[]

  @@index([businessId, startsAt])
  @@index([customerId, startsAt])
  @@index([status, startsAt])
  // Defensa en profundidad contra doble reserva: la garantía única es un índice
  // único PARCIAL sobre (professionalId, startsAt) limitado a turnos
  // PENDING/CONFIRMED (creado vía SQL en la migración
  // 20260916000001_allow_rebooking_freed_slots). Así un turno CANCELLED no
  // bloquea la re-reserva de la misma franja. La serialización concurrente la
  // aporta runBookingTransaction (FOR UPDATE + hasConflict).
}

// Plan de suscripción (global, gestionado por la plataforma).
model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  // Límites del plan (ej: {"maxProfessionals": 5, "maxAppointmentsPerDay": 50})
  limits      Json?
  isActive    Boolean  @default(true)
  // Frecuencia de cobro recurrente
  interval           SubscriptionInterval @default(MONTH)
  intervalCount      Int                   @default(1)
  // Preapproval Plan creado en Mercado Pago para este plan
  mercadoPagoPlanId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                        String             @id @default(cuid())
  businessId                String
  planId                    String
  status                    SubscriptionStatus @default(PENDING)
  mercadoPagoSubscriptionId String?
  // Estado crudo reportado por Mercado Pago (revisión/diagnóstico)
  mpStatus                 String?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  canceledAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  events   SubscriptionEvent[]

  @@index([businessId])
  @@index([planId])
  @@index([mercadoPagoSubscriptionId])
}

// Registro de eventos de webhook de Mercado Pago. Su objetivo principal es
// la idempotencia: cada evento (mpEventId) se procesa exactamente una vez,
// aunque Mercado Pago reintente el delivery.
model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  eventType      String
  mpEventId      String   @unique
  payload        Json
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventType])
}

model Reminder {
  id            String          @id @default(cuid())
  businessId    String
  appointmentId String
  customerId    String
  channel       ReminderChannel @default(EMAIL)
  status        ReminderStatus  @default(PENDING)
  scheduledAt   DateTime
  sentAt        DateTime?
  failedAt      DateTime?
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Idempotencia: no programar el mismo recordatorio dos veces
  @@unique([appointmentId, channel, scheduledAt])
  @@index([businessId])
  @@index([status, scheduledAt])
  @@index([customerId])
}
